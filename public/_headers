# Caching & performance headers for Cloudflare Pages

# Static assets with cache hashing (Vite output in /assets)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Favicon and SVGs
/*.svg
  Cache-Control: public, max-age=86400

# HTML pages - revalidate so updates are instant on Cloudflare
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Root SPA fallback
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
